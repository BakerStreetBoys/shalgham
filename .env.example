# Copy this to .env for local dev (not used on Railway -- set these as
# Railway service Variables instead). Everything here is optional.

# Password of the single admin account (password-only login). Used only the
# first time the app starts, before an admin exists. Defaults to "admin".
# ADMIN_PASSWORD=admin

# Secret used to sign session cookies. If unset, a random one is generated on
# first boot and stored in the database.
# SESSION_SECRET=replace-with-a-real-random-value

# Where panel.db is stored. Defaults to the Railway Volume mount path, or
# ./data when no Volume is attached.
# DATA_DIR=./data

# Initial proxy secret (32 hex characters). Used only on the very first boot;
# afterwards the secret is managed in the panel. Random if unset.
# SECRET=a3f1c07e9b2d4856e0c1f7b39d6a284c

# Port of the raw TCP listener used by the MTProto, SOCKS5 and HTTP modes.
# On Railway, point the service's TCP Proxy at this application port.
# PROXY_PORT=8443
