<%- include('partials/header', { loggedIn: false }) %>
<div class="login-shell">
  <div class="card login-card">
    <h1 class="brand login-title">SOLO<span>Proxy</span></h1>
    <p class="muted login-sub">Sign in to manage your proxy.</p>
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <form method="POST" action="<%= panelPath %>/login">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label for="password">Password</label>
      <input type="password" id="password" name="password" required autofocus />
      <button type="submit" class="btn btn-accent btn-block">Sign in</button>
    </form>
  </div>
</div>
<%- include('partials/footer') %>
